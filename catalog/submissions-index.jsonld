{
  "@context": {
    "dcat": "http://www.w3.org/ns/dcat#",
    "dct": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "sdx": "https://github.com/urpx-org/urpx-data-sandbox/ns#",
    "title": "dct:title",
    "description": "dct:description",
    "dataset": {
      "@id": "dcat:dataset",
      "@container": "@set"
    },
    "distribution": {
      "@id": "dcat:distribution",
      "@container": "@set"
    },
    "conformsTo": {
      "@id": "dct:conformsTo",
      "@type": "@id"
    },
    "downloadURL": {
      "@id": "dcat:downloadURL",
      "@type": "xsd:anyURI"
    },
    "mediaType": "dcat:mediaType",
    "fileKind": "sdx:fileKind",
    "storagePath": "sdx:storagePath",
    "utility": "sdx:utility",
    "jurisdiction": "sdx:jurisdiction",
    "commodity": {
      "@id": "sdx:commodity",
      "@container": "@set"
    },
    "serviceClass": {
      "@id": "sdx:serviceClass",
      "@container": "@set"
    },
    "rateGroup": {
      "@id": "sdx:rateGroup",
      "@container": "@set"
    },
    "ratePlan": {
      "@id": "sdx:ratePlan",
      "@container": "@set"
    },
    "ratePlanIdentifier": "sdx:ratePlanIdentifier",
    "ratePlanName": "sdx:ratePlanName",
    "urpxVersion": "sdx:urpxVersion",
    "ratePlanCount": {
      "@id": "sdx:ratePlanCount",
      "@type": "xsd:integer"
    },
    "ratePlanVersionCount": {
      "@id": "sdx:ratePlanVersionCount",
      "@type": "xsd:integer"
    },
    "pricingModelCount": {
      "@id": "sdx:pricingModelCount",
      "@type": "xsd:integer"
    },
    "priceDefinitionCount": {
      "@id": "sdx:priceDefinitionCount",
      "@type": "xsd:integer"
    },
    "priceCount": {
      "@id": "sdx:priceCount",
      "@type": "xsd:integer"
    },
    "effectiveDateStart": {
      "@id": "sdx:effectiveDateStart",
      "@type": "xsd:date"
    },
    "effectiveDateEnd": {
      "@id": "sdx:effectiveDateEnd",
      "@type": "xsd:date"
    },
    "hasExternalPriceReference": {
      "@id": "sdx:hasExternalPriceReference",
      "@type": "xsd:boolean"
    },
    "dateAdded": {
      "@id": "sdx:dateAdded",
      "@type": "xsd:date"
    }
  },
  "@id": "submissions-index",
  "@type": "dcat:Catalog",
  "title": "URPX data sandbox submissions catalog",
  "description": "Machine-generated index of every submission under submissions/ that has passed gate 1. Each entry's facets — utility, commodity, rate plans, service class, version, dates — are read from the submitted metadata, not from the directory path. Regenerated by scripts/update_catalog_index.py on every push to the default branch; do not hand-edit.",
  "dataset": []
}
